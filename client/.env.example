# Base URL for API requests. Leave as /api in development (Vite proxies it).
# In production, set it to the deployed server, for example https://api.example.com/api
VITE_API_URL=/api

# Development only: where the Vite proxy forwards /api requests.
VITE_DEV_API_TARGET=http://localhost:5000

# Public website origin, used for canonical URLs, social previews, robots.txt
# and the sitemap. Required for production builds, for example https://alokpaul.dev
VITE_SITE_URL=

# Optional: absolute API URL the build uses to list projects and blog posts in
# sitemap.xml. Defaults to VITE_API_URL when that is absolute. If the API cannot
# be reached during the build, the sitemap lists the static pages only.
SITEMAP_API_URL=

# Development only: set to "true" to send anonymous page views while running npm run dev.
# Off by default so local testing never adds to the real visitor statistics.
VITE_ANALYTICS_IN_DEV=
