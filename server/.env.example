# Runtime
NODE_ENV=development
PORT=5000

# Comma-separated list of origins allowed to call the API (the client URL).
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string. Required in production.
# In development the server starts without a database if this is empty.
MONGODB_URI=

# Admin authentication
# Secret used to sign session tokens. Required in production, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long an admin session lasts, in days.
AUTH_SESSION_DAYS=7
# lax: client and API share a site. none: hosted on different sites (requires HTTPS).
COOKIE_SAME_SITE=lax

# Used only by the seed script (npm run seed:admin -w server).
# Remove ADMIN_PASSWORD from this file after the admin account is created.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary image uploads. Uploads return 503 until all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder for uploads (sub-folders: projects, blog, general).
CLOUDINARY_FOLDER=portfolio

# Proxies in front of the API: 1 for a single host (Render, Railway); 2 when the website's
# host also forwards /api to the API. Used so rate limits see each visitor's own address.
TRUST_PROXY=1

# Visitor statistics count calendar days in this time zone (default Asia/Dhaka).
ANALYTICS_TIMEZONE=Asia/Dhaka

# GitHub Activity section (GET /api/github).
GITHUB_USERNAME=alokpaul369-cyber
# Optional personal access token with no scopes; raises the rate limit from 60 to 5,000/hour.
GITHUB_TOKEN=
# How long GitHub data is cached on the server.
GITHUB_CACHE_MINUTES=60

# Contact form email (Nodemailer). Defaults target Gmail.
# SMTP_PASS must be a Gmail app password (Google Account > Security > 2-Step Verification
# > App passwords), not your normal password.
# In development, if SMTP_USER or SMTP_PASS is empty, emails are logged instead of sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Display name on outgoing emails.
MAIL_FROM_NAME=Alok Paul
# Inbox for new-message notifications. Defaults to SMTP_USER.
CONTACT_RECIPIENT=
# Link included in the auto-reply. Defaults to the first CLIENT_URL.
SITE_URL=
